            "schema": {
              "type": "string"
            },
            "example": "application/json"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/BaseActionRequest" },
                  {
                    "type": "object",
                    "properties": {
                      "action": { "example": "rename_group" },
                      "params": { "$ref": "#/components/schemas/RenameGroupParams" }
                    }
                  }
                ]
              },
              "example": {
                "action": "rename_group",
                "params": {"group_id": "group_id_abc", "new_name": "分组新名称"},
                "echo": "echo_rename_group"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作结果",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/BaseActionResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "type": "object", "description": "成功时为空对象" }
                      }
                    }
                  ]
                },
                "example": {
                  "status": "ok", "retcode": 0, "data": {}, "echo": "echo_rename_group"
                }
              }
            }
          }
        }
      }
    },
    "/get_groups": {
      "post": {
        "summary": "获取所有分组 (POST)",
        "operationId": "getGroupsPost",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "认证Token，例如：Bearer YOUR_TOKEN",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Bearer {{ACCESS_TOKEN}}"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "请求体的内容类型",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "application/json"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/BaseActionRequest" },
                  {
                    "type": "object",
                    "properties": {
                      "action": { "example": "get_groups" },
                      "params": { "$ref": "#/components/schemas/GetGroupsParams", "example": {} }
                    }
                  }
                ]
              },
              "example": {
                "action": "get_groups",
                "params": {},
                "echo": "echo_get_groups_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作结果",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/BaseActionResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Group" }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "status": "ok", "retcode": 0, "data": [{"id": "grp1", "name": "Group Alpha"}, {"id": "grp2", "name": "Group Beta"}], "echo": "echo_get_groups_post"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "获取所有分组 (GET)",
        "operationId": "getGroupsGet",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "认证Token，例如：Bearer YOUR_TOKEN",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Bearer {{ACCESS_TOKEN}}"
          },
          { "name": "action", "in": "query", "required": true, "schema": { "type": "string" }, "description": "固定为 'get_groups'", "example": "get_groups" },
          { "name": "echo", "in": "query", "schema": { "type": "string" }, "description": "原样返回字段", "example": "echo_get_groups_get" }
        ],
        "responses": {
          "200": {
            "description": "操作结果",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/BaseActionResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Group" }
                        }
                      }
                    }
                  ]
