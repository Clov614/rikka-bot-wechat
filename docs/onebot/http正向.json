    "/chat_image/{image_path}": {
      "get": {
        "summary": "获取聊天图片",
        "operationId": "getChatImage",
        "description": "根据图片的相对路径获取图片内容。image_path 部分是 /chat_image/ 之后的所有路径字符串，例如 /chat_image/2024/07/my_image.jpg 中的 '2024/07/my_image.jpg'。",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "认证Token，例如：Bearer YOUR_TOKEN",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Bearer {{ACCESS_TOKEN}}"
          },
          {
            "name": "image_path",
            "in": "path",
            "required": true,
            "description": "图片的相对路径 (例如 2023/12/image.jpg )",
            "schema": {
              "type": "string"
            },
            "example": "2024/07/example_image.png"
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回图片数据",
            "content": {
              "image/jpeg": {},
              "image/png": {},
              "image/gif": {},
              "image/*": {"description": "其他图片类型"}
            }
          },
          "403": {
            "description": "鉴权失败",
             "content": {
              "application/json": {
                "schema": { "type": "object", "properties": {"error": {"type": "string", "example": "鉴权失败"}} }
              }
            }
          },
          "404": {
            "description": "图片未找到",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {"type": "string", "example": "image not found"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
